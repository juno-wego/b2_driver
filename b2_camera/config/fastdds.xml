<?xml version="1.0" encoding="UTF-8"?>
<!-- ROS camera topics stay on the project's local loopback graph.
     Unitree SDK communication uses its separately selected network interface. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>b2_camera_loopback_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="b2_camera_loopback" is_default_profile="true">
    <rtps>
      <!-- Pace 1080p fragments instead of bursting an entire 6.2 MB frame
           into the project's small, OS-capped UDP receive buffer. -->
      <flow_controller_descriptor_list>
        <flow_controller_descriptor>
          <name>b2_camera_paced</name>
          <scheduler>FIFO</scheduler>
          <max_bytes_per_period>65536</max_bytes_per_period>
          <period_ms>1</period_ms>
        </flow_controller_descriptor>
      </flow_controller_descriptor_list>
      <userTransports>
        <transport_id>b2_camera_loopback_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
  <publisher profile_name="b2_camera_paced_writer" is_default_profile="true">
    <qos>
      <publishMode>
        <kind>ASYNCHRONOUS</kind>
        <flow_controller_name>b2_camera_paced</flow_controller_name>
      </publishMode>
      <data_sharing><kind>OFF</kind></data_sharing>
    </qos>
    <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
  </publisher>
  <subscriber profile_name="b2_camera_reader" is_default_profile="true">
    <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
  </subscriber>
</profiles>
